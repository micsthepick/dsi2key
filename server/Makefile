before_release__linux_: 
	cmd /c if not exist bin\\Release\\Linux md bin\\Release\\Linux
	cmd /c if not exist $(OBJDIR_RELEASE__LINUX_) md $(OBJDIR_RELEASE__LINUX_)
	cmd /c if not exist $(OBJDIR_RELEASE__LINUX_)\\iniparser\\src md $(OBJDIR_RELEASE__LINUX_)\\iniparser\\src
	cmd /c if not exist $(OBJDIR_RELEASE__LINUX_)\\core md $(OBJDIR_RELEASE__LINUX_)\\core

after_release__linux_: 

release__linux_: before_release__linux_ out_release__linux_ after_release__linux_

out_release__linux_: before_release__linux_ $(OBJ_RELEASE__LINUX_) $(DEP_RELEASE__LINUX_)
	$(LD) $(LIBDIR_RELEASE__LINUX_) -o $(OUT_RELEASE__LINUX_) $(OBJ_RELEASE__LINUX_)  $(LDFLAGS_RELEASE__LINUX_) $(LIB_RELEASE__LINUX_)

$(OBJDIR_RELEASE__LINUX_)\\main.o: main.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c main.cpp -o $(OBJDIR_RELEASE__LINUX_)\\main.o

$(OBJDIR_RELEASE__LINUX_)\\iniparser\\src\\iniparser.o: iniparser\\src\\iniparser.c
	$(CC) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c iniparser\\src\\iniparser.c -o $(OBJDIR_RELEASE__LINUX_)\\iniparser\\src\\iniparser.o

$(OBJDIR_RELEASE__LINUX_)\\iniparser\\src\\dictionary.o: iniparser\\src\\dictionary.c
	$(CC) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c iniparser\\src\\dictionary.c -o $(OBJDIR_RELEASE__LINUX_)\\iniparser\\src\\dictionary.o

$(OBJDIR_RELEASE__LINUX_)\\core\\udp.o: core\\udp.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\udp.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\udp.o

$(OBJDIR_RELEASE__LINUX_)\\core\\key.o: core\\key.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\key.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\key.o

$(OBJDIR_RELEASE__LINUX_)\\core\\input.o: core\\input.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\input.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\input.o

$(OBJDIR_RELEASE__LINUX_)\\core\\iniParser.o: core\\iniParser.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\iniParser.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\iniParser.o

$(OBJDIR_RELEASE__LINUX_)\\core\\core.o: core\\core.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\core.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\core.o

$(OBJDIR_RELEASE__LINUX_)\\core\\config.o: core\\config.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\config.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\config.o

$(OBJDIR_RELEASE__LINUX_)\\core\\client.o: core\\client.cpp
	$(CXX) $(CFLAGS_RELEASE__LINUX_) $(INC_RELEASE__LINUX_) -c core\\client.cpp -o $(OBJDIR_RELEASE__LINUX_)\\core\\client.o

clean_release__linux_: 
	cmd /c del /f $(OBJ_RELEASE__LINUX_) $(OUT_RELEASE__LINUX_)
	cmd /c rd bin\\Release\\Linux
	cmd /c rd $(OBJDIR_RELEASE__LINUX_)
	cmd /c rd $(OBJDIR_RELEASE__LINUX_)\\iniparser\\src
	cmd /c rd $(OBJDIR_RELEASE__LINUX_)\\core

